{
  "version": 1,
  "source": "alibaba/open-code-review@v1.13.8",
  "fallback": "default.md",
  "note": "globs is REEVE's own selection rule, not upstream's internal mapping. Entries marked contextOnly are never auto-selected; read them only when the project context makes them obviously relevant.",
  "rules": [
    { "file": "arkts.md", "group": "language", "globs": ["*.ets"] },
    { "file": "astro.md", "group": "language", "globs": ["*.astro"] },
    { "file": "c.md", "group": "language", "globs": ["*.c", "*.h"], "note": "A .h in a C++ or Objective-C project should read cpp.md or objc.md instead." },
    { "file": "clojure.md", "group": "language", "globs": ["*.clj", "*.cljs", "*.cljc", "*.edn"] },
    { "file": "cpp.md", "group": "language", "globs": ["*.cpp", "*.cc", "*.cxx", "*.hpp", "*.hh", "*.hxx"] },
    { "file": "csharp.md", "group": "language", "globs": ["*.cs", "*.csx"] },
    { "file": "default.md", "group": "fallback", "globs": [] },
    { "file": "elm.md", "group": "language", "globs": ["*.elm"] },
    { "file": "fsharp.md", "group": "language", "globs": ["*.fs", "*.fsx", "*.fsi"] },
    { "file": "go.md", "group": "language", "globs": ["*.go"] },
    { "file": "graphql.md", "group": "language", "globs": ["*.graphql", "*.gql"] },
    { "file": "haskell.md", "group": "language", "globs": ["*.hs", "*.lhs"] },
    { "file": "java.md", "group": "language", "globs": ["*.java"] },
    { "file": "jsonnet.md", "group": "language", "globs": ["*.jsonnet", "*.libsonnet"] },
    { "file": "julia.md", "group": "language", "globs": ["*.jl"] },
    { "file": "kotlin.md", "group": "language", "globs": ["*.kt", "*.kts"] },
    { "file": "matlab.md", "group": "language", "globs": [], "contextOnly": true, "note": ".m is ambiguous with Objective-C; select it only for MATLAB-style projects." },
    { "file": "nim.md", "group": "language", "globs": ["*.nim"] },
    { "file": "nushell.md", "group": "language", "globs": ["*.nu"] },
    { "file": "objc.md", "group": "language", "globs": ["*.m", "*.mm"], "note": "If the project is MATLAB, read matlab.md instead." },
    { "file": "ocaml.md", "group": "language", "globs": ["*.ml", "*.mli"] },
    { "file": "php.md", "group": "language", "globs": ["*.php"] },
    { "file": "powershell.md", "group": "language", "globs": ["*.ps1", "*.psm1", "*.psd1"] },
    { "file": "python.md", "group": "language", "globs": ["*.py", "*.pyi"] },
    { "file": "r.md", "group": "language", "globs": ["*.r", "*.rmd"] },
    { "file": "rego.md", "group": "language", "globs": ["*.rego"] },
    { "file": "rust.md", "group": "language", "globs": ["*.rs"] },
    { "file": "scala.md", "group": "language", "globs": ["*.scala", "*.sc"] },
    { "file": "shader.md", "group": "language", "globs": ["*.glsl", "*.hlsl", "*.frag", "*.vert", "*.comp", "*.shader"] },
    { "file": "solidity.md", "group": "language", "globs": ["*.sol"] },
    { "file": "starlark.md", "group": "language", "globs": ["*.bzl", "*.star", "BUILD", "BUILD.bazel", "WORKSPACE", "WORKSPACE.bazel"] },
    { "file": "swift.md", "group": "language", "globs": ["*.swift"] },
    { "file": "ts_js_tsx_jsx.md", "group": "language", "globs": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs", "*.mts", "*.cts"] },
    { "file": "verilog.md", "group": "language", "globs": ["*.v", "*.sv", "*.svh", "*.vh"] },
    { "file": "vhdl.md", "group": "language", "globs": ["*.vhd", "*.vhdl"] },
    { "file": "vyper.md", "group": "language", "globs": ["*.vy"] },
    { "file": "zig.md", "group": "language", "globs": ["*.zig"] },

    { "file": "build_gradle.md", "group": "config", "globs": ["build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts", "gradle.properties"] },
    { "file": "cargo_toml.md", "group": "config", "globs": ["Cargo.toml"] },
    { "file": "composer_json.md", "group": "config", "globs": ["composer.json"] },
    { "file": "github_config.md", "group": "config", "globs": [".github/**/*.yml", ".github/**/*.yaml"], "note": "Applies after github_workflows.md; .github/workflows/** always wins." },
    { "file": "github_workflows.md", "group": "config", "globs": [".github/workflows/**"], "note": "Checked before every other glob." },
    { "file": "json.md", "group": "config", "globs": ["*.json", "*.jsonc"] },
    { "file": "mapper_dao_xml.md", "group": "config", "globs": ["*Mapper.xml", "*Dao.xml"] },
    { "file": "package_json.md", "group": "config", "globs": ["package.json"] },
    { "file": "po.md", "group": "config", "globs": ["*.po"] },
    { "file": "pom_xml.md", "group": "config", "globs": ["pom.xml"] },
    { "file": "pot.md", "group": "config", "globs": ["*.pot"] },
    { "file": "properties.md", "group": "config", "globs": ["*.properties"] },
    { "file": "yaml.md", "group": "config", "globs": ["*.yml", "*.yaml"], "note": "Fallback for YAML outside .github/." },

    { "file": "ejs_liquid_njk.md", "group": "template", "globs": ["*.ejs", "*.liquid", "*.njk"] },
    { "file": "erb.md", "group": "template", "globs": ["*.erb"] },
    { "file": "freemarker.md", "group": "template", "globs": ["*.ftl", "*.ftlh"] },
    { "file": "haml_slim.md", "group": "template", "globs": ["*.haml", "*.slim"] },
    { "file": "handlebars_mustache.md", "group": "template", "globs": ["*.hbs", "*.handlebars", "*.mustache"] },
    { "file": "jinja.md", "group": "template", "globs": ["*.jinja", "*.jinja2", "*.j2"] },
    { "file": "pug.md", "group": "template", "globs": ["*.pug", "*.jade"] },

    { "file": "bicep.md", "group": "infra", "globs": ["*.bicep"] },
    { "file": "capnp.md", "group": "infra", "globs": ["*.capnp"] },
    { "file": "nix.md", "group": "infra", "globs": ["*.nix"] },
    { "file": "prisma.md", "group": "infra", "globs": ["*.prisma"] },
    { "file": "protobuf.md", "group": "infra", "globs": ["*.proto"] },
    { "file": "terraform.md", "group": "infra", "globs": ["*.tf", "*.tfvars", "*.tofu"] },
    { "file": "thrift.md", "group": "infra", "globs": ["*.thrift"] }
  ]
}
