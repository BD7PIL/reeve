// REEVE —— 引擎侧配置样板：把它放进 <实例 HOME>/.config/opencode/opencode.jsonc
//
// 全部内容就这些。三个档位模型、内置 agent 的可见性、默认 agent、代理的取件/拉起/守护/收敛、
// 台账与名册 —— **都由插件注册和持有**（见 plugin/src/models.js 与 plugin/src/proxy.js）。
//
// 唯一代替不了的是**端点**那两行：v2 的插件 API 里 Provider.Info 没有 URL 字段、
// Connection 只是凭据引用、Integration 只是"怎么拿凭据"——所以"往哪发"必须写在配置里。
//
// ⚠️ 三种写法都实测过（2026-10-19/20，EL7 staging）：
//   · 不写 apiKey 也能跑（引擎就不发 Authorization，而插件自持的代理把回环鉴权关掉了）；
//   · 想把回环收紧回 virtual key：写 `"apiKey": "{env:REEVE_VK}"`，并由**启动器**把 VK 注进
//     引擎环境（插件改不了引擎的环境变量），同时给 proxy 加 `"requireVirtualKey": true`；
//   · `"proxy": true` 是 `{ "enabled": true }` 的简写；端口不用写 —— 从 baseURL 推。

{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "reeve": { "package": "@ai-sdk/openai-compatible", "settings": { "baseURL": "http://127.0.0.1:8080/v1" } }
  },

  "model": "reeve/pro",

  "plugins": [
    {
      "package": "@bd7pil/reeve",
      "options": {
        "limits": { "default": 8 },
        "retentionDays": 30,
        "proxy": true
      }
    }
  ]
}
